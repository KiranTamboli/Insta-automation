# ---------- Instagram (Graph API) ----------
# Needs an Instagram Business or Creator account.
# IG_ACCESS_TOKEN = token from developers.facebook.com -> your app -> Instagram -> API setup with Instagram login -> Generate token
# IG_USER_ID = optional. Leave blank and the app looks up the numeric ID from your token.
#              (This is a number like 17841400000000000, NOT your @username.)
IG_ACCESS_TOKEN=
IG_USER_ID=
# graph.instagram.com -> "Instagram API with Instagram Login" (recommended)
# graph.facebook.com  -> if you connected IG via a Facebook Page (Facebook Login)
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v21.0

# ---------- AI editor (recommended) ----------
# Easiest: paste your key in the dashboard ("Turn on the AI editor") - it is saved here automatically.
# Free:  GEMINI_API_KEY from https://aistudio.google.com/apikey
# Paid:  ANTHROPIC_API_KEY from https://console.anthropic.com (Claude, best quality)
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# gemini or claude (only needed if you set both keys)
AI_PROVIDER=

# ---------- Processing ----------
# Whisper model: tiny / base / small / medium  (bigger = better captions, slower)
WHISPER_MODEL=base
# Reel layout: track (follow the speaker's face), blur (video on blurred background) or crop (center crop)
REEL_LAYOUT=track
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=55
DEFAULT_HASHTAGS=#reels #viral #trending #explore

# ---------- App ----------
TIMEZONE=Asia/Kolkata
PORT=8000
